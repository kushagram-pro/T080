# Copy to .env and fill in. URL-encode special characters in the password (@ -> %40).
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/faculty_portal
# Tests use DATABASE_URL's database + "_test" automatically; override with TEST_DATABASE_URL if needed.

# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
REFRESH_SECRET_KEY=change-me-too

# Leave empty in development: emails are then logged instead of sent
# (password reset links appear in the backend log).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=verified-sender@example.com

ALLOWED_EMAIL_DOMAIN=lnmiit.ac.in
FRONTEND_ORIGIN=http://localhost:5173
# true in production (HTTPS only)
COOKIE_SECURE=false

# Optional, defaults shown
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7
# PASSWORD_RESET_EXPIRE_MINUTES=30
